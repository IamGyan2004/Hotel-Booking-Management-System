{
  "name": "staywise-hotel-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost --port 5001",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "fullstack": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview --host localhost --port 4173"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "bcryptjs": "latest",
    "concurrently": "latest",
    "cors": "latest",
    "dotenv": "latest",
    "express": "latest",
    "vite": "latest",
    "react": "latest",
    "react-dom": "latest",
    "lucide-react": "latest",
    "jsonwebtoken": "latest",
    "mongoose": "latest"
  },
  "devDependencies": {}
}
